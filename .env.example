# Runtime
ENVIRONMENT=production
PORT=8080
PUBLIC_BASE_URL=https://your-gateway.example.com

# OpenAI Realtime
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin

# Telnyx Call Control and webhook verification
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_STREAM_AUTH_TOKEN=

# Make / HPG Dispatch appointment-request action (optional until enabled)
MAKE_DISPATCH_WEBHOOK_URL=
MAKE_DISPATCH_AUTH_TOKEN=
MAKE_DISPATCH_TIMEOUT_SECONDS=8
